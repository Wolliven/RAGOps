<!DOCTYPE html>
<html lang="ja">
<head>
  <meta charset="UTF-8">
  <title><%= title %></title>

  <link rel="stylesheet"
        href="https://stackpath.bootstrapcdn.com/bootstrap/4.4.1/css/bootstrap.min.css"
        crossorigin="anonymous">

  <link rel="stylesheet" href="/stylesheets/style.css">
</head>

<body class="container">
  <header class="mt-4 mb-4">
    <h1 class="display-4">検索履歴</h1>
    <a href="/ragops/search" class="btn btn-secondary">検索へ戻る</a>
  </header>

  <table class="table">
    <tr>
      <th>ID</th>
      <th>質問</th>
      <th>結果数</th>
      <th>日時</th>
    </tr>

    <% for (var i = 0; i < history.length; i++) { %>
      <% var item = history[i]; %>
      <tr>
        <td><%= item.id %></td>
        <td><%= item.query %></td>
        <td><%= item.top_k %></td>
        <td><%= item.created_at %></td>
      </tr>
    <% } %>
  </table>
</body>
</html>
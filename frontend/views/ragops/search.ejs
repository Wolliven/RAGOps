<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title><%= title %></title>

  <link
    rel="stylesheet"
    href="https://stackpath.bootstrapcdn.com/bootstrap/4.4.1/css/bootstrap.min.css"
    crossorigin="anonymous"
  >

  <link rel="stylesheet" href="/stylesheets/style.css">
</head>

<body class="container">
  <header class="mt-4 mb-4">
    <h1 class="display-4">RAGOps Web Manager</h1>
    <p>Upload documents and search their content by meaning.</p>

    <a href="/ragops/history" class="btn btn-secondary">
      Search History
    </a>
  </header>

  <main>
    <!-- Upload section -->
    <section class="mb-5">
      <h2>1. Upload Document</h2>

      <p>Select a TXT, Markdown, or PDF file.</p>

      <% if (upload_error) { %>
        <div class="alert alert-danger">
          <%= upload_error %>
        </div>
      <% } %>

      <% if (upload_message) { %>
        <div class="alert alert-success">
          <%= upload_message %>
        </div>
      <% } %>

      <form
        id="upload-form"
        method="post"
        action="/ragops/upload"
        enctype="multipart/form-data"
      >
        <div class="form-group">
          <label for="file">File</label>

          <input
            type="file"
            name="file"
            id="file"
            accept=".txt,.md,.pdf"
            class="form-control-file"
            required
          >
        </div>

        <button
          type="submit"
          id="upload-button"
          class="btn btn-success"
        >
          Upload and Process
        </button>
      </form>

      <div
        id="upload-loading"
        class="mt-3"
        style="display: none;"
      >
        <div
          class="spinner-border spinner-border-sm text-primary"
          role="status"
        >
          <span class="sr-only">Loading...</span>
        </div>

        <span class="ml-2">
          Processing the document. This may take a moment.
        </span>
      </div>

      <% if (upload_data) { %>
        <div class="card mt-3">
          <div class="card-header">
            Processing Result
          </div>

          <div class="card-body">
            <pre class="mb-0"><%= JSON.stringify(upload_data, null, 2) %></pre>
          </div>
        </div>
      <% } %>
    </section>

    <hr>

    <!-- Search section -->
    <section class="mt-5">
      <h2>2. Semantic Search</h2>

      <% if (error) { %>
        <div class="alert alert-danger">
          <%= error %>
        </div>
      <% } %>

      <form method="post" action="/ragops/search">
        <div class="form-group">
          <label for="query">Question</label>

          <input
            type="text"
            name="query"
            id="query"
            value="<%= query %>"
            class="form-control"
            placeholder="Ask a question about your documents"
            required
          >
        </div>

        <div class="form-group">
          <label for="top_k">Number of Results</label>

          <input
            type="number"
            name="top_k"
            id="top_k"
            value="<%= top_k %>"
            min="1"
            max="10"
            class="form-control"
          >
        </div>

        <button type="submit" class="btn btn-primary">
          Search
        </button>
      </form>

      <% if (results && results.length > 0) { %>
        <hr>

        <h2>Search Results</h2>

        <% for (let i = 0; i < results.length; i++) { %>
          <% const result = results[i]; %>

          <div class="card mt-3">
            <div class="card-header">
              Result <%= i + 1 %>
              |
              Score:

              <% if (result.semantic_score != null) { %>
                <%= Number(result.semantic_score).toFixed(4) %>
              <% } else if (result.score != null) { %>
                <%= Number(result.score).toFixed(4) %>
              <% } else { %>
                N/A
              <% } %>

              |
              Source: <%= result.source_file %>
              |
              Chunk: <%= result.chunk_id %>
            </div>

            <div class="card-body">
              <p class="mb-0"><%= result.text %></p>
            </div>
          </div>
        <% } %>
      <% } else if (results) { %>
        <div class="alert alert-warning mt-4">
          No search results were found.
        </div>
      <% } %>
    </section>
  </main>

  <script>
    const uploadForm = document.getElementById('upload-form');
    const uploadButton = document.getElementById('upload-button');
    const uploadLoading = document.getElementById('upload-loading');

    uploadForm.addEventListener('submit', function () {
      uploadButton.disabled = true;
      uploadButton.textContent = 'Processing...';
      uploadLoading.style.display = 'block';
    });

    // Prevent the spinner from remaining visible when returning to the page.
    window.addEventListener('pageshow', function () {
      uploadButton.disabled = false;
      uploadButton.textContent = 'Upload and Process';
      uploadLoading.style.display = 'none';
    });
  </script>
</body>
</html>
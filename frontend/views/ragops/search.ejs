<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title><%= title %></title>

  <link
    rel="stylesheet"
    href="https://stackpath.bootstrapcdn.com/bootstrap/4.4.1/css/bootstrap.min.css"
    crossorigin="anonymous"
  >

  <link rel="stylesheet" href="/stylesheets/style.css">
</head>

<body class="container">
  <header class="mt-4 mb-4">
    <h1 class="display-4">RAGOps Web Manager</h1>
    <p>Upload documents and search their content by meaning.</p>

    <a href="/ragops/history" class="btn btn-secondary">
      Search History
    </a>
  </header>

  <main>
    <!-- Upload section -->
    <section class="mb-5">
      <h2>1. Upload Document</h2>

      <p>Select a TXT, Markdown, or PDF file.</p>

      <% if (upload_error) { %>
        <div class="alert alert-danger">
          <%= upload_error %>
        </div>
      <% } %>

      <% if (upload_message) { %>
        <div class="alert alert-success">
          <%= upload_message %>
        </div>
      <% } %>

      <form
        id="upload-form"
        method="post"
        action="/ragops/upload"
        enctype="multipart/form-data"
      >
        <div class="form-group">
          <label for="file">File</label>

          <input
            type="file"
            name="file"
            id="file"
            accept=".txt,.md,.pdf"
            class="form-control-file"
            required
          >
        </div>

        <button
          type="submit"
          id="upload-button"
          class="btn btn-success"
        >
          Upload and Process
        </button>
      </form>

      <div
        id="upload-loading"
        class="mt-3"
        style="display: none;"
      >
        <div
          class="spinner-border spinner-border-sm text-primary"
          role="status"
        >
          <span class="sr-only">Loading...</span>
        </div>

        <span class="ml-2">
          Processing the document. This may take a moment.
        </span>
      </div>

      <% if (upload_data) { %>
        <div class="card mt-3">
          <div class="card-header">
            Processing Result
          </div>

          <div class="card-body">
            <pre class="mb-0"><%= JSON.stringify(upload_data, null, 2) %></pre>
          </div>
        </div>
      <% } %>
    </section>

    <!-- Indexed documents section -->
    <section class="mb-5">
      <div class="d-flex justify-content-between align-items-center mb-3">
        <div>
          <h2 class="mb-1">2. Indexed Documents</h2>
          <p class="text-muted mb-0">
            Documents currently available for search.
          </p>
        </div>

        <div class="text-right">
          <div class="mb-2">
            <button
              type="button"
              id="select-all-button"
              class="btn btn-sm btn-outline-primary"
            >
              Select all
            </button>

            <button
              type="button"
              id="deselect-all-button"
              class="btn btn-sm btn-outline-secondary"
            >
              Deselect all
            </button>
          </div>

          <span
            id="document-count"
            class="badge badge-secondary"
          >
            0 documents
          </span>

          <span
            id="selected-count"
            class="badge badge-primary ml-1"
          >
            0 selected
          </span>
        </div>
      </div>

      <div id="documents-loading" class="text-muted">
        <div
          class="spinner-border spinner-border-sm"
          role="status"
        >
          <span class="sr-only">Loading...</span>
        </div>

        <span class="ml-2">Loading indexed documents...</span>
      </div>

      <div
        id="documents-error"
        class="alert alert-danger"
        style="display: none;"
      ></div>
      <div
        id="documents-message"
        class="alert alert-success"
        style="display: none;"
      ></div>

      <div
        id="documents-empty"
        class="border rounded p-4 text-center text-muted"
        style="display: none;"
      >
        No indexed documents yet. Upload one to begin.
      </div>

      <div id="documents-list"></div>
    </section>

    <hr>

    <!-- Search section -->
    <section class="mt-5">
      <h2>3. Search Documents</h2>

      <% if (error) { %>
        <div class="alert alert-danger">
          <%= error %>
        </div>
      <% } %>

      <form
        id="search-form"
        method="post"
        action="/ragops/search"
      >
        <input
          type="hidden"
          name="document_ids_json"
          id="document-ids-input"
          value="<%= JSON.stringify(selected_document_ids) %>"
        >

        <div
          id="selection-error"
          class="alert alert-warning"
          style="display: none;"
        >
          Select at least one document before searching.
        </div>
        <div class="form-group">
          <label for="query">Question</label>

          <input
            type="text"
            name="query"
            id="query"
            value="<%= query %>"
            class="form-control"
            placeholder="Ask a question about your documents"
            required
          >
        </div>

        <div class="form-group">
          <label for="search_method">Search Method</label>

          <select
            name="search_method"
            id="search_method"
            class="form-control"
          >
            <option
              value="hybrid"
              <%= search_method === 'hybrid' ? 'selected' : '' %>
            >
              Hybrid
            </option>

            <option
              value="semantic"
              <%= search_method === 'semantic' ? 'selected' : '' %>
            >
              Semantic
            </option>

            <option
              value="bm25"
              <%= search_method === 'bm25' ? 'selected' : '' %>
            >
              BM25
            </option>
          </select>

          <small class="form-text text-muted">
            Hybrid combines semantic and keyword-based retrieval.
          </small>
        </div>

        <div class="form-group">
          <label for="top_k">Number of Results</label>

          <input
            type="number"
            name="top_k"
            id="top_k"
            value="<%= top_k %>"
            min="1"
            max="10"
            class="form-control"
          >
        </div>

        <button type="submit" class="btn btn-primary">
          Search
        </button>
      </form>

      <% if (results && results.length > 0) { %>
        <hr>

        <h2>
          Search Results
          <small class="text-muted">
            — <%= search_method.toUpperCase() %>
          </small>
        </h2>

        <% for (let i = 0; i < results.length; i++) { %>
          <% const result = results[i]; %>

          <div class="card mt-3">
            <div class="card-header">
              Result <%= i + 1 %>
              |
              Score:

              <% if (result.semantic_score != null) { %>
                <%= Number(result.semantic_score).toFixed(4) %>
              <% } else if (result.score != null) { %>
                <%= Number(result.score).toFixed(4) %>
              <% } else { %>
                N/A
              <% } %>

              |
              Source: <%= result.source_file %>
              |
              Chunk: <%= result.chunk_id %>
            </div>

            <div class="card-body">
              <p class="mb-0"><%= result.text %></p>
            </div>
          </div>
        <% } %>
      <% } else if (results) { %>
        <div class="alert alert-warning mt-4">
          No search results were found.
        </div>
      <% } %>
    </section>
  </main>

  <script>
    // Upload elements
    const uploadForm = document.getElementById('upload-form');
    const uploadButton = document.getElementById('upload-button');
    const uploadLoading = document.getElementById('upload-loading');

    // Indexed document elements
    const documentsLoading = document.getElementById('documents-loading');
    const documentsError = document.getElementById('documents-error');
    const documentsMessage = document.getElementById('documents-message');
    const documentsEmpty = document.getElementById('documents-empty');
    const documentsList = document.getElementById('documents-list');
    const documentCount = document.getElementById('document-count');
    const selectedCount = document.getElementById('selected-count');
    const selectAllButton = document.getElementById('select-all-button');
    const deselectAllButton = document.getElementById('deselect-all-button');

    const searchForm = document.getElementById('search-form');
    const documentIdsInput = document.getElementById('document-ids-input');
    const selectionError = document.getElementById('selection-error');
    const initialSelectedDocumentIds = JSON.parse(documentIdsInput.value);


    function formatUploadDate(uploadedAt) {
      if (!uploadedAt) {
        return 'Upload date unavailable';
      }

      const date = new Date(uploadedAt);

      if (Number.isNaN(date.getTime())) {
        return 'Upload date unavailable';
      }

      return `Uploaded ${date.toLocaleDateString(undefined, {
        year: 'numeric',
        month: 'short',
        day: 'numeric'
      })}`;
    }

    function updateSelectionCount() {
      const checkboxes = Array.from(
        document.querySelectorAll('.document-checkbox')
      );

      const selectedCheckboxes = checkboxes.filter(
        checkbox => checkbox.checked
      );

      selectedCount.textContent =
        `${selectedCheckboxes.length} selected`;

      selectAllButton.disabled =
        checkboxes.length === 0 ||
        selectedCheckboxes.length === checkboxes.length;

      deselectAllButton.disabled =
        checkboxes.length === 0 ||
        selectedCheckboxes.length === 0;
    }

    async function deleteDocument(documentData, deleteButton) {
      const confirmed = window.confirm(
        `Delete "${documentData.filename}"?\n\n` +
        'This will remove the document and its indexed data.'
      );

      if (!confirmed) {
        return;
      }

      const selectedDocumentIds = Array.from(
        document.querySelectorAll('.document-checkbox:checked')
      ).map(checkbox => checkbox.value);

      documentsMessage.style.display = 'none';
      documentsError.style.display = 'none';

      deleteButton.disabled = true;
      deleteButton.textContent = 'Deleting...';

      try {
        const response = await fetch(
          `/ragops/documents/${encodeURIComponent(documentData.document_id)}`,
          {
            method: 'DELETE'
          }
        );

        if (!response.ok) {
          const data = await response.json().catch(() => null);

          throw new Error(
            data?.detail ||
            data?.error ||
            'Could not delete the document.'
          );
        }

        documentsMessage.textContent =
          `${documentData.filename} was deleted successfully.`;

        documentsMessage.style.display = 'block';

        const remainingSelectedDocumentIds =
          selectedDocumentIds.filter(
            documentId =>
              documentId !== documentData.document_id
          );

        await loadDocuments(remainingSelectedDocumentIds);
      } catch (error) {
        console.error(error);

        documentsError.textContent = error.message;
        documentsError.style.display = 'block';

        deleteButton.disabled = false;
        deleteButton.textContent = 'Delete';
      }
    }

    function renderDocuments(
      documents,
      selectedDocumentIds = initialSelectedDocumentIds
    ) {
      documentsList.innerHTML = '';

      documentCount.textContent =
        `${documents.length} document${documents.length === 1 ? '' : 's'}`;

      if (documents.length === 0) {
        documentsEmpty.style.display = 'block';
        updateSelectionCount();
        return;
      }

      documentsEmpty.style.display = 'none';

      for (const [index, documentData] of documents.entries()) {
        const card = document.createElement('div');
        card.className = 'card mb-2';

        const body = document.createElement('div');
        body.className =
          'card-body d-flex justify-content-between align-items-center';

        const leftSide = document.createElement('div');
        leftSide.className = 'd-flex align-items-start';

        const checkboxContainer = document.createElement('div');
        checkboxContainer.className =
          'custom-control custom-checkbox mr-3 mt-1';

        const checkbox = document.createElement('input');
        checkbox.type = 'checkbox';
        checkbox.className =
          'custom-control-input document-checkbox';
        checkbox.id = `document-checkbox-${index}`;
        checkbox.value = documentData.document_id;
        checkbox.checked =
        selectedDocumentIds === null ||
        selectedDocumentIds.includes(
          documentData.document_id
        );

        checkbox.addEventListener('change', updateSelectionCount);

        const checkboxLabel = document.createElement('label');
        checkboxLabel.className = 'custom-control-label';
        checkboxLabel.htmlFor = checkbox.id;
        checkboxLabel.setAttribute(
          'aria-label',
          `Select ${documentData.filename}`
        );

        checkboxContainer.appendChild(checkbox);
        checkboxContainer.appendChild(checkboxLabel);

        const information = document.createElement('div');

        const name = document.createElement('h5');
        name.className = 'card-title mb-1';
        name.textContent = documentData.filename;

        const date = document.createElement('p');
        date.className = 'card-text text-muted small mb-0';
        date.textContent = formatUploadDate(documentData.uploaded_at);

        information.appendChild(name);
        information.appendChild(date);

        const details = document.createElement('details');
        details.className = 'mt-2';

        const summary = document.createElement('summary');
        summary.className = 'text-muted small';
        summary.style.cursor = 'pointer';
        summary.textContent = 'Details';

        const technicalInfo = document.createElement('div');
        technicalInfo.className = 'small text-muted mt-2';

        const technical = documentData.technical || {};

        const documentIdLine = document.createElement('div');
        documentIdLine.textContent =
          `Document ID: ${documentData.document_id}`;

        const chunkLine = document.createElement('div');
        chunkLine.textContent =
          `Chunks: ${technical.chunk_count ?? 'N/A'}`;

        const characterLine = document.createElement('div');
        characterLine.textContent =
          `Characters: ${
            technical.characters != null
              ? technical.characters.toLocaleString()
              : 'N/A'
          }`;

        const embeddingLine = document.createElement('div');
        embeddingLine.textContent =
          `Embedding dimensions: ${
            technical.embedding_dimensions ?? 'N/A'
          }`;

        technicalInfo.appendChild(documentIdLine);
        technicalInfo.appendChild(chunkLine);
        technicalInfo.appendChild(characterLine);
        technicalInfo.appendChild(embeddingLine);

        details.appendChild(summary);
        details.appendChild(technicalInfo);

        information.appendChild(details);

        const actions = document.createElement('div');
        actions.className = 'd-flex align-items-center';

        const typeBadge = document.createElement('span');
        typeBadge.className = 'badge badge-light border mr-2';
        typeBadge.textContent = documentData.file_type
          ? documentData.file_type.replace('.', '').toUpperCase()
          : 'FILE';

        const deleteButton = document.createElement('button');
        deleteButton.type = 'button';
        deleteButton.className = 'btn btn-sm btn-outline-danger';
        deleteButton.textContent = 'Delete';

        deleteButton.addEventListener('click', function () {
          deleteDocument(documentData, deleteButton);
        });

        actions.appendChild(typeBadge);
        actions.appendChild(deleteButton);

        leftSide.appendChild(checkboxContainer);
        leftSide.appendChild(information);

        body.appendChild(leftSide);
        body.appendChild(actions);

        card.appendChild(body);
        documentsList.appendChild(card);
      }

      updateSelectionCount();
    }


    async function loadDocuments(
      selectedDocumentIds = initialSelectedDocumentIds
    ) {
      documentsLoading.style.display = 'block';
      documentsError.style.display = 'none';
      documentsEmpty.style.display = 'none';

      try {
        const response = await fetch('/ragops/documents');

        if (!response.ok) {
          throw new Error('Could not retrieve indexed documents.');
        }

        const data = await response.json();

        renderDocuments(
          data.documents || [],
          selectedDocumentIds
        );
      } catch (error) {
        console.error(error);

        documentsError.textContent =
          'The indexed document list could not be loaded.';

        documentsError.style.display = 'block';
      } finally {
        documentsLoading.style.display = 'none';
      }
    }


    // Show the upload spinner while Express processes the file.
    uploadForm.addEventListener('submit', function () {
      uploadButton.disabled = true;
      uploadButton.textContent = 'Processing...';
      uploadLoading.style.display = 'block';
    });

    selectAllButton.addEventListener('click', function () {
      const checkboxes =
        document.querySelectorAll('.document-checkbox');

      for (const checkbox of checkboxes) {
        checkbox.checked = true;
      }

      updateSelectionCount();
    });


    deselectAllButton.addEventListener('click', function () {
      const checkboxes =
        document.querySelectorAll('.document-checkbox');

      for (const checkbox of checkboxes) {
        checkbox.checked = false;
      }

      updateSelectionCount();
    });

    searchForm.addEventListener('submit', function (event) {
      const selectedDocumentIds = Array.from(
        document.querySelectorAll(
          '.document-checkbox:checked'
        )
      ).map(checkbox => checkbox.value);

      if (selectedDocumentIds.length === 0) {
        event.preventDefault();

        selectionError.style.display = 'block';
        return;
      }

      selectionError.style.display = 'none';

      documentIdsInput.value =
        JSON.stringify(selectedDocumentIds);
    });


    // Runs when the page is first shown and when returning with "Back".
    window.addEventListener('pageshow', function () {
      uploadButton.disabled = false;
      uploadButton.textContent = 'Upload and Process';
      uploadLoading.style.display = 'none';

      loadDocuments();
    });
  </script>
</body>
</html>